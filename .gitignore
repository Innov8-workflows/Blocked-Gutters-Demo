# Whitelist: only the built site and the deploy workflow are published.
# build.js, generate.js, build-*.js, site.config.js, content/, _src, _source, _site, _live, old-site,
# every .md and the raw client photographs stay local (the site-security gate flags them as S1 if served).
# The pages below are mirrored from _site/ by `PUBLISH=1 node generate.js` (GitHub Pages serves main root).
*
!.gitignore
!.github/
!.github/**
!.nojekyll
!index.html
!404.html
!robots.txt
!sitemap.xml
!media/
!media/*.mp4
!assets/
!assets/**
!about/
!about/**
!contact-us/
!contact-us/**
!customer-reviews/
!customer-reviews/**
!faqs/
!faqs/**
!gutter-cleaning-locations/
!gutter-cleaning-locations/**
!gutter-cleaning-roof-cleaning/
!gutter-cleaning-roof-cleaning/**
!new-gutters-fascias-soffits/
!new-gutters-fascias-soffits/**
!our-work/
!our-work/**
!privacy-policy/
!privacy-policy/**
!terms/
!terms/**
!services/
!services/**
# old website URLs: noindex refresh stubs to their new pages (the real domain 301s them via _redirects)
!roof-cleaning-locations/
!roof-cleaning-locations/**
!why-your-gutters-need-cleaning/
!why-your-gutters-need-cleaning/**
!sitemap/
!sitemap/**
